# Local settings for the development scripts (scripts/android, scripts/git). Copy to .env, which
# git ignores.
# Android SDK location, if not in the default place (e.g. %LOCALAPPDATA%\Android\Sdk).
# ANDROID_HOME=C:\path\to\Android\Sdk
# Maestro launcher, if not in the default place.
# MAESTRO_BIN=C:\path\to\maestro\bin\maestro.bat
# gitleaks for npm run secrets and the pre-push hook, if not on PATH or in the winget folder.
# GITLEAKS_BIN=C:\path\to\gitleaks.exe
