# Local settings for the emulator scripts (scripts/android). Copy to .env, which git ignores.
# Android SDK location, if not in the default place (e.g. %LOCALAPPDATA%\Android\Sdk).
# ANDROID_HOME=C:\path\to\Android\Sdk
# Maestro launcher, if not in the default place.
# MAESTRO_BIN=C:\path\to\maestro\bin\maestro.bat
